# 后端同源反代模板：容器启动时 envsubst 渲染为 /etc/nginx/conf.d/default.conf。
# 唯一注入变量 ${BACKEND_UPSTREAM}（compose 默认 host.docker.internal:48080）；
# 其余 $host/$uri 等 nginx 运行时变量不在容器环境内，不会被 envsubst 替换。
# 注意 proxy_set_header 不跨级继承：/infra/ws 内重复了 server 级头。
server {
  listen 8080;
  server_name localhost;

  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  # 前端静态资源（SPA，hash 路由，与下方代理前缀零冲突）
  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /index.html;
    index index.html;
  }

  # 后端 REST API
  location /admin-api/ {
    proxy_pass http://${BACKEND_UPSTREAM};
  }

  # 后端健康检查（供后端仓库 CI 与排障使用；默认无详情，不泄露信息）
  location = /actuator/health {
    proxy_pass http://${BACKEND_UPSTREAM};
  }

  # WebSocket（IM 与客服复用 /infra/ws 端点）
  location /infra/ws {
    proxy_pass http://${BACKEND_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_read_timeout 300s;
  }

  # 基础设施面板：Druid / Knife4j(doc.html + 依赖资源) / 积木报表 / Spring Boot Admin
  location /druid/ {
    proxy_pass http://${BACKEND_UPSTREAM};
  }
  location /doc.html {
    proxy_pass http://${BACKEND_UPSTREAM};
  }
  location /webjars/ {
    proxy_pass http://${BACKEND_UPSTREAM};
  }
  location /v3/api-docs {
    proxy_pass http://${BACKEND_UPSTREAM};
  }
  location /swagger-resources {
    proxy_pass http://${BACKEND_UPSTREAM};
  }
  location /jmreport/ {
    proxy_pass http://${BACKEND_UPSTREAM};
  }
  location /drag/ {
    proxy_pass http://${BACKEND_UPSTREAM};
  }
  location /admin/ {
    proxy_pass http://${BACKEND_UPSTREAM};
  }

  error_page 500 502 503 504 /50x.html;

  location = /50x.html {
    root /usr/share/nginx/html;
  }
}
